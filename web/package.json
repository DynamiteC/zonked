{
  "name": "zonked-web",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "check:privacy": "node ../scripts/check-privacy.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:scripts": "node --test scripts/"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false
  }
}
