{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "isolatedModules": true, "noEmit": true, "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@zonked-web/*": ["../../web/src/*"] }
  },
  "include": ["src", "../../web/src/audio/*.ts", "../../web/src/sbg/*.ts"],
  "exclude": ["../../web/src/**/*.test.ts"]
}
